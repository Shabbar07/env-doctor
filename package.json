{
  "name": "@with_ezz/env-doctor",
  "version": "0.1.1",
  "description": "Find environment variable problems in JS/TS projects: missing, unused, undocumented, and typos.",
  "keywords": [
    "env",
    "dotenv",
    "environment-variables",
    "cli",
    "doctor",
    "linter",
    "vite",
    "node",
    "developer-tools"
  ],
  "author": "with_ezz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shabbar07/env-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/Shabbar07/env-doctor/issues"
  },
  "homepage": "https://github.com/Shabbar07/env-doctor#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "env-doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.7"
  }
}
